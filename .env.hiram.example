# Hiram environment configuration template. Copy to .env and fill in the values.
# Production reads everything from the environment; user-secrets are a dev-only convenience.
# Nested configuration keys use a double underscore.

# --- Postgres (shared EasyStok instance, dedicated hiram database, least-privilege role) ---
ConnectionStrings__Hiram=Host=postgres;Port=5432;Database=hiram;Username=hiram;Password=CHANGE_ME

# --- RabbitMQ (dispatcher only) ---
ConnectionStrings__RabbitMq=amqp://hiram:CHANGE_ME@rabbitmq:5672/

# --- Redis (api idempotency fast-path and api-key throttle) ---
ConnectionStrings__Redis=redis:6379,abortConnect=false

# --- Admin endpoints (provisional tenant and api-key management) ---
Hiram__AdminKey=CHANGE_ME

# --- Data Protection shared key ring (same volume mounted into api and dispatcher) ---
DataProtection__KeysPath=/var/hiram/dataprotection-keys

# --- Schema migrations (keep false in production; the schema is applied by the --migrate-only job) ---
Hiram__MigrateOnStartup=false

# --- Platform email provider defaults (per-tenant overrides live in the database) ---
# Settings keys under Settings__ are provider specific; these illustrate the SMTP provider.
Hiram__Email__Platform__Provider=smtp
Hiram__Email__Platform__Secret=
Hiram__Email__Platform__Settings__Host=smtp.example.com
Hiram__Email__Platform__Settings__Port=587
Hiram__Email__Platform__Settings__From=notifications@example.com
Hiram__Email__Platform__Settings__Username=

# --- Web Push VAPID ---
Hiram__Push__Vapid__Subject=mailto:ops@example.com
Hiram__Push__Vapid__PublicKey=CHANGE_ME
Hiram__Push__Vapid__PrivateKey=CHANGE_ME

# --- Metering (credit cost; base per channel plus per-kilobyte) ---
Hiram__Metering__DefaultBase=1
Hiram__Metering__PerKilobyte=1
Hiram__Metering__ChannelBase__Email=1
Hiram__Metering__ChannelBase__Push=1

# --- OpenTelemetry (LGTM collector OTLP endpoint) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm:4317
