# Hiram Core environment template. Copy to .env and replace every CHANGE_ME value.
# Production reads configuration from the environment; nested keys use a double underscore.

# PostgreSQL is the only required stateful dependency.
ConnectionStrings__Hiram=Host=postgres;Port=5432;Database=hiram;Username=hiram;Password=CHANGE_ME

# Operator-only endpoints for tenant and API-key provisioning.
Hiram__AdminKey=CHANGE_ME

# The API and workers run in the same process. Disable workers only during migration or diagnosis.
Hiram__Workers__Enabled=true

# Persist this directory and back it up with the database. It decrypts provider and tenant secrets.
DataProtection__KeysPath=/var/hiram/dataprotection-keys

# Keep false in production. Apply schema with the same image using --migrate-only before rollout.
Hiram__MigrateOnStartup=false

# Platform email fallback. Per-tenant provider settings stored in PostgreSQL take precedence.
# SMTP setting names are case-sensitive and lowercase.
Hiram__Email__Platform__Provider=smtp
Hiram__Email__Platform__Secret=
Hiram__Email__Platform__Settings__host=smtp.example.com
Hiram__Email__Platform__Settings__port=587
Hiram__Email__Platform__Settings__from=notifications@example.com
Hiram__Email__Platform__Settings__security=starttls
Hiram__Email__Platform__Settings__username=

# Optional OTLP collector. Remove this variable when telemetry export is not configured.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
