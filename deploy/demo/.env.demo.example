# Demo environment secrets (ADR-022). Copy to .env next to docker-compose.demo.yml and fill in.
# Generate passwords with: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME
RABBITMQ_PASSWORD=CHANGE_ME
HIRAM_ADMIN_KEY=CHANGE_ME

# Public host served by Caddy. sslip.io resolves to the VM ip without DNS registration.
DEMO_HOST=20.98.234.200.sslip.io
ACME_EMAIL=ops@example.com

# Sender shown on demo emails landing in Mailpit.
DEMO_MAIL_FROM=notifications@demo.hiram

# Generate with: docker run --rm node:22-alpine npx --yes web-push generate-vapid-keys --json
VAPID_SUBJECT=mailto:ops@example.com
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
