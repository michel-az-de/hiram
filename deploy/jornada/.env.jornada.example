# Provisionamento do tenant Jornada do Candidato. Copie para .env ao lado deste arquivo e ajuste.
# Somente nomes e placeholders: nenhum valor real de credencial entra em arquivo versionado.

# Hiram alvo. O padrao e o compose local (docker-compose.dev.yml na raiz do repo).
HIRAM_BASE_URL=http://localhost:3357
HIRAM_ADMIN_KEY=admin-dev-local

# Nome do tenant criado pelo subcomando tenant.
JORNADA_TENANT_NAME=jornada-do-candidato

# Canais das rotinas, separados por virgula: email, sms e whatsapp. O mix decide quais providers sao
# configurados, quais templates sao criados e quais canais entram nas rotinas. O e-mail de verificacao
# e a excecao: ele fica sempre so no canal email, porque um link de confirmacao nao faz sentido fora
# da caixa de entrada.
JORNADA_CHANNELS=email

# Guids de usuarios de teste que recebem opt-in explicito nos canais pedidos, em transactional e
# operational. Vazio = nenhum. Obrigatorio para WhatsApp: sem registro o Hiram suprime a mensagem.
JORNADA_TEST_USER_IDS=

# Api key ja emitida, para reprovisionar sem gerar outra. Vazio = o script emite e mostra uma vez.
#HIRAM_JORNADA_API_KEY=hk_live_CHANGE_ME

# Credencial Twilio (ADR-028), lida pelo subcomando providers. Uma conta e uma api key servem os tres
# canais; so o remetente muda. O SID da conta e o SID da api key vao para settings, em claro; o secret
# vai para o campo protegido por Data Protection e nunca e ecoado. Os valores reais ficam em user-secrets
# no desenvolvimento e no cofre do ambiente em producao, nunca em arquivo versionado. Sem estas
# variaveis o subcomando avisa e pula o canal, sem falhar.
TWILIO_ACCOUNT_SID=ACCHANGE_ME
TWILIO_API_KEY_SID=SKCHANGE_ME
TWILIO_API_KEY_SECRET=CHANGE_ME

# Remetentes em E.164, sem espaco e sem parenteses.
TWILIO_SMS_FROM=+15550000000
# ATENCAO: o console da Twilio mostra o remetente do sandbox como "whatsapp:+15550000000", mas aqui vai
# so o numero. O prefixo "whatsapp:" e responsabilidade do adapter, que o acrescenta no envio; grava-lo
# aqui produziria "whatsapp:whatsapp:+15550000000" e toda mensagem seria recusada.
TWILIO_WHATSAPP_FROM=+15550000000

# Conta trial: o provider so aceita conteudo pre-aprovado, entao o adapter envia a chave da mensagem
# aprovada no lugar do corpo renderizado. Vale para sms e email; o adapter de WhatsApp nao tem modo
# trial, porque o sandbox aceita texto livre dentro da janela de 24h. Com TWILIO_TRIAL_MODE=true o
# script exige a chave do canal correspondente, senao pula o canal em vez de configurar um provider
# que so poderia falhar.
TWILIO_TRIAL_MODE=false
#TWILIO_SMS_TRIAL_TEMPLATE=CHANGE_ME

# E-mail pela Twilio Email API. Fora isso o e-mail sai pelo provider da plataforma (SMTP ou MTA) e o
# script nao toca no canal.
USE_TWILIO_EMAIL=false
#TWILIO_EMAIL_FROM=nao-responda@CHANGE_ME
#TWILIO_EMAIL_FROM_NAME=Jornada do Candidato
#TWILIO_EMAIL_TRIAL_SUBJECT=CHANGE_ME
#TWILIO_EMAIL_TRIAL_HTML=CHANGE_ME
