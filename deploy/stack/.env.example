# Copy to .env and fill in. .env is gitignored, chmod 600, owned by the deploy user, and backed up
# off-host together with the Data Protection key ring and deploy/levante/.provision-state.

# Image tags. Default latest; pin to reviewed commit SHAs at go-live.
HIRAM_IMAGE_TAG=latest
LEVANTE_IMAGE_TAG=latest

# Public host and TLS. GAP-A: use the final domain. Until it lands, a sslip.io host works
# (e.g. 203-0-113-10.sslip.io). SITE_URL feeds the newsletter confirmation link.
SITE_HOST=levante.example.com
SITE_URL=https://levante.example.com
ACME_EMAIL=ops@example.com

# MongoDB do Levante: Atlas externo (replica set, backup/PITR gerenciados). O IP publico da VM entra
# no allowlist do Atlas. O usuario NAO pode ter role administrativa (o boot do Levante aborta em
# Producao se tiver, regra de privilegio minimo).
MONGO_CONNECTION_STRING=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/levante?retryWrites=true&w=majority

# Secrets. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME
RABBITMQ_PASSWORD=CHANGE_ME
HIRAM_ADMIN_KEY=CHANGE_ME
LEVANTE_JWT_SECRET=CHANGE_ME_at_least_32_characters_long_secret
LEVANTE_ORIGEM_HASH_SECRET=CHANGE_ME_at_least_32_characters_long_secret
LEVANTE_ADMIN_EMAIL=admin@levante.example.com
LEVANTE_ADMIN_SENHA=CHANGE_ME
LEVANTE_ADMIN_NOTIFICACOES_EMAIL=moderacao@levante.example.com

# Email sender shown in Mailpit (swap the dispatcher provider env for a real provider when GAP-A lands).
MAIL_FROM=no-reply@levante.example.com

# Filled AFTER the first provision-levante.sh run: the Levante tenant API key (hk_live_..., shown once).
HIRAM_LEVANTE_API_KEY=

# Web Push (optional). Generate a VAPID pair if you enable push.
VAPID_SUBJECT=mailto:ops@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
