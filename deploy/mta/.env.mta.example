# Stalwart MTA for Hiram (ADR-026). Copy this to `.env` in this directory and fill it in. The real
# `.env` is git-ignored. The only secrets here are the relay password and the submission secret; the
# DKIM private key is NOT here, generate it into ./stalwart/dkim/hiram.key (git-ignored). See README.md.

# Pin a tested Stalwart image tag (verify at hub.docker.com/r/stalwartlabs). Avoid `latest` in prod.
STALWART_TAG=latest

# EHLO name; must match the forward and reverse DNS (PTR) of the sending host.
MTA_HOSTNAME=mta.hiram.dev

# The domain messages are signed and sent from. Must be verified on the relay with DMARC alignment.
MTA_SENDING_DOMAIN=hiram.dev
MTA_DKIM_SELECTOR=hiram

# Secret the Hiram dispatcher uses to authenticate its submission to Stalwart.
MTA_SUBMISSION_SECRET=change-me

# Authenticated smarthost for the last hop. Use SES SMTP or a dedicated relay to keep independence;
# using Resend here is only a transitional bridge (see ADR-026). The port is fixed at 587.
MTA_RELAY_HOST=email-smtp.sa-east-1.amazonaws.com
MTA_RELAY_USERNAME=change-me
MTA_RELAY_PASSWORD=change-me
