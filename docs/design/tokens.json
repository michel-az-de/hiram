{
  "$meta": {
    "name": "Hiram Design Tokens",
    "version": "0.1.0",
    "date": "2026-06-10",
    "description": "Fonte canonica de tokens. Temas: dark (aboboda) e light (pedra). Ver docs/design/DESIGN-SYSTEM.md."
  },
  "color": {
    "lodge": {
      "50": "#EEF3FA",
      "100": "#D8E3F3",
      "200": "#B3C8E7",
      "300": "#87A7D6",
      "400": "#5D86C2",
      "500": "#3E68A8",
      "600": "#2C4F8A",
      "700": "#1B3A6B",
      "800": "#142C52",
      "900": "#0E1F3B",
      "950": "#0A1428"
    },
    "orient": {
      "50": "#FBF6E7",
      "100": "#F5EAC4",
      "200": "#EBD88E",
      "300": "#DFC25B",
      "400": "#D4B13C",
      "500": "#C9A227",
      "600": "#A98621",
      "700": "#86691B",
      "800": "#644E15",
      "900": "#44350F"
    },
    "ashlar": {
      "50": "#F8F7F4",
      "100": "#F0EEE8",
      "200": "#E2DFD6",
      "300": "#CCC8BC",
      "400": "#ABA79A",
      "500": "#8A867A",
      "600": "#6B675D",
      "700": "#524F47",
      "800": "#3A3833",
      "900": "#262522",
      "950": "#171614"
    },
    "acacia": {
      "50": "#EFF5EC",
      "100": "#DCE9D6",
      "300": "#A4C496",
      "500": "#6C9B5D",
      "600": "#548047",
      "700": "#426637",
      "900": "#22351D"
    },
    "danger": {
      "50": "#FAEDEA",
      "100": "#F3D2CC",
      "300": "#DE9183",
      "500": "#B3402F",
      "600": "#963426",
      "700": "#77281D"
    },
    "warning": {
      "50": "#FBF1E4",
      "100": "#F4DCBB",
      "300": "#E0AC62",
      "500": "#B45309",
      "700": "#7C3A08"
    }
  },
  "theme": {
    "dark": {
      "bg": "{color.lodge.950}",
      "surface": "#0F1B30",
      "raised": "#142440",
      "text": "#E8ECF4",
      "textMuted": "#94A3BD",
      "border": "rgba(179, 200, 231, 0.14)",
      "borderStrong": "rgba(179, 200, 231, 0.26)",
      "actionPrimaryBg": "{color.orient.500}",
      "actionPrimaryText": "{color.lodge.950}",
      "actionPrimaryHover": "{color.orient.400}",
      "link": "{color.orient.300}",
      "focusRing": "{color.orient.400}",
      "statusDelivered": "{color.acacia.300}",
      "statusQueued": "{color.lodge.300}",
      "statusFailed": "{color.danger.300}",
      "statusSuppressed": "{color.ashlar.400}"
    },
    "light": {
      "bg": "{color.ashlar.50}",
      "surface": "#FFFFFF",
      "raised": "{color.ashlar.100}",
      "text": "#1C2433",
      "textMuted": "{color.ashlar.600}",
      "border": "{color.ashlar.200}",
      "borderStrong": "{color.ashlar.300}",
      "actionPrimaryBg": "{color.lodge.700}",
      "actionPrimaryText": "#FFFFFF",
      "actionPrimaryHover": "{color.lodge.600}",
      "link": "{color.lodge.600}",
      "focusRing": "{color.orient.600}",
      "statusDelivered": "{color.acacia.700}",
      "statusQueued": "{color.lodge.600}",
      "statusFailed": "{color.danger.600}",
      "statusSuppressed": "{color.ashlar.600}"
    }
  },
  "font": {
    "display": "'Space Grotesk', system-ui, sans-serif",
    "body": "'IBM Plex Sans', system-ui, sans-serif",
    "mono": "'IBM Plex Mono', ui-monospace, monospace"
  },
  "type": {
    "xs": "12px",
    "sm": "14px",
    "base": "16px",
    "md": "18px",
    "lg": "20px",
    "xl": "24px",
    "2xl": "32px",
    "3xl": "40px",
    "4xl": "56px",
    "lineBody": "1.6",
    "lineDisplay": "1.15"
  },
  "tracking": {
    "lapidar": "0.32em",
    "tight": "-0.01em"
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "6": "24px",
    "8": "32px",
    "12": "48px",
    "16": "64px",
    "24": "96px"
  },
  "radius": {
    "sm": "6px",
    "md": "10px",
    "lg": "14px",
    "full": "999px",
    "ashlarCut": "16px"
  },
  "shadow": {
    "lightSm": "0 1px 2px rgba(20, 30, 50, 0.06)",
    "lightMd": "0 4px 12px rgba(20, 30, 50, 0.07)",
    "dark": "none"
  },
  "motion": {
    "fast": "150ms",
    "base": "200ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "pattern": {
    "mosaicSize": "24px",
    "mosaicOpacity": "0.04"
  }
}
